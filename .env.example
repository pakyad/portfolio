# IyadLLM — knowledge-grounded chat assistant
# Copy to .env.local and fill in real values.

# Groq API key for the LLM backend
GROQ_API_KEY=

# Upstash Redis (REST) for rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limit: messages per visitor per window (default 15/hour)
IYADLLM_RATE_LIMIT=15

# Max reply tokens (default 400)
IYADLLM_MAX_TOKENS=400